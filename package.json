{
  "name": "familyos",
  "version": "0.1.0",
  "private": true,
  "description": "FamilyOS command-line tools",
  "bin": {
    "familyos": "./bin/familyos.js"
  },
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "setup": "npm install --no-audit --no-fund && node bin/familyos.js setup",
    "doctor": "node bin/familyos.js doctor",
    "brief": "node bin/familyos.js brief",
    "personalized-brief": "node bin/familyos.js personalized-brief",
    "config": "node bin/familyos.js config",
    "whatsapp:link": "node bin/familyos.js whatsapp:link",
    "whatsapp:status": "node bin/familyos.js whatsapp:status",
    "family": "node bin/familyos.js family",
    "listen": "node bin/familyos.js listen"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "6.7.23",
    "pino": "9.14.0",
    "qrcode-terminal": "0.12.0"
  }
}
