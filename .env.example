# Notion integration token (create one at https://www.notion.so/my-integrations)
NOTION_TOKEN=

# Notion database IDs — share each database with your integration first.
# Copy the ID from the database URL (the 32-character segment before any "?").
NOTION_DB_TASKS=
NOTION_DB_CALENDAR=
NOTION_DB_BILLS=
NOTION_DB_DOCUMENTS=

# IANA timezone used when calculating "today", e.g. Asia/Jakarta
TIMEZONE=UTC

# Where "familyos brief" sends its output: "console" (default) or "whatsapp"
BRIEF_TRANSPORT=console

# Phone number to send the brief to via WhatsApp (digits only, with country
# code, no "+" or spaces) — typically your own number ("message yourself").
# Only used when BRIEF_TRANSPORT=whatsapp. Run "npm run whatsapp:link" first.
WHATSAPP_TARGET=
