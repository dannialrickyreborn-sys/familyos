# Notion integration token (create one at https://www.notion.so/my-integrations)
NOTION_TOKEN=

# Notion database IDs — share each database with your integration first.
# Copy the ID from the database URL (the 32-character segment before any "?").
NOTION_DB_TASKS=
NOTION_DB_CALENDAR=
NOTION_DB_BILLS=
NOTION_DB_DOCUMENTS=

# IANA timezone used when calculating "today", e.g. Asia/Jakarta
TIMEZONE=UTC
